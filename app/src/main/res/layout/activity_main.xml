<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <!-- Status + enable -->
    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enableBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turn on background capture" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/batteryBtn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Keep alive" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/autoSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Auto-save selected text" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toolbarSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chrome &amp; other apps: tap “Save to notes” for me" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/sourceSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add app name &amp; time" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toastSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show “Saved” popup" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/editableSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ignore text boxes I’m typing in" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Link a file" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Copy all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Clear" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/linkedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <EditText
        android:id="@+id/notes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:gravity="top|start"
        android:hint="@string/notes_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:scrollbars="vertical"
        android:textAppearance="?attr/textAppearanceBodyMedium" />
</LinearLayout>
